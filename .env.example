# Disha AI Environment Configuration Template

# Application Environment (local | production)
APP_ENV=local

# Data Mode (snapshot | synthetic)
DATA_MODE=snapshot

# Database Connection (Neon PostgreSQL with SSL; leave empty to run in-memory)
DATABASE_URL=

# CORS Allowed Origins (comma-separated URLs)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM Configuration (OpenAI-compatible hosted open-weight or Ollama)
LLM_ENABLED=false
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
LLM_TIMEOUT_S=12
RATE_LIMIT_CHAT_PER_MIN=20

# Logging
LOG_LEVEL=INFO

# Frontend Public Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_MOCK=0
NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
